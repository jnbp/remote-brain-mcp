# Copy this file to `.env` and fill in your own values. Never commit `.env`.

# Folder with your Markdown notes on the host (absolute path).
VAULT_PATH=/path/to/your/notes

# Folder for the search index on the host (absolute path, writable by PUID).
DATA_PATH=/path/to/remote-brain-mcp/data

# User and group that own your notes. On Linux: `id -u` and `id -g`.
# On Synology: the user's UID (often 1026 or higher) and group "users" (100).
PUID=1000
PGID=1000

# Leave empty: the server creates a random token on first start, prints it once in the
# log and keeps it in DATA_PATH/token. Or set your own: openssl rand -hex 32
RB_TOKEN=

# Host names the server answers to. Must include the public host name of your tunnel.
RB_ALLOWED_HOSTS=localhost,127.0.0.1,notes.example.com

# Where the port is published on the host. See compose.yaml.
RB_PUBLISH=127.0.0.1:8080

# Only for compose.cloudflare.yaml: token of the tunnel that serves this container.
CLOUDFLARE_TUNNEL_TOKEN=

# Optional
RB_SCAN_INTERVAL_SECONDS=60
RB_TRASH_RETENTION_DAYS=90
RB_EXCLUDE=
RB_ALLOWED_ORIGINS=
RB_LOG_LEVEL=info
